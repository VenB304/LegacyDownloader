# Local / per-install state (config.txt is auto-created on first run)
config.txt
config.txt.bak
config.txt.orig
rclone.conf
bin/songcatalog.cache.json
update-helper.log
bin_old_*/
bin_new_*/

# Always-on troubleshooting log (bin\logs\) - per-install runtime output,
